  pages = {101007},
  file = {ScienceDirect Full Text PDF:/Users/hakaseh/Zotero/storage/LVBIA8GG/Li et al. - 2025 - Early career ocean professionals’ declaration on ocean negative carbon emissions for our ocean and f.pdf:application/pdf;ScienceDirect Snapshot:/Users/hakaseh/Zotero/storage/GLVQCIY3/S2666675825002103.html:text/html},
