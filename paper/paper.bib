  pages = {s80--s97},
  file = {Balmaseda et al_2015_The Ocean Reanalyses Intercomparison Project (ORA-IP).pdf:/Users/hakaseh/Zotero/storage/FVGW5BLC/Balmaseda et al_2015_The Ocean Reanalyses Intercomparison Project (ORA-IP).pdf:application/pdf},
